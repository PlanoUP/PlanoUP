# ------------------------------------------------------------------
# Legalize One — variáveis de ambiente
#
# Prefixo VITE_ = embutido no bundle do navegador (público). NUNCA coloque
# segredos de servidor aqui (ex.: SUPABASE_SERVICE_ROLE_KEY).
# Na Vercel: Project Settings → Environment Variables (Production e Preview).
# Variáveis VITE_* só valem após um novo deploy.
# ------------------------------------------------------------------

# ===== Plataforma SaaS (Supabase) =====
# MODO DUPLO: sem URL + ANON KEY o site funciona exatamente como a V1
# (catálogo local em src/data, marca Legalize, nada gravado).
# Com as duas, imobiliária/imóveis/leads/eventos vêm do banco (protegido por RLS).
VITE_SUPABASE_URL=
# Chave "anon"/"publishable": pública por design (a segurança está nas políticas RLS).
VITE_SUPABASE_ANON_KEY=
# Bucket público das mídias dos imóveis. Padrão se vazio: property-media
VITE_SUPABASE_STORAGE_BUCKET=
# Imobiliária exibida quando o domínio não identifica nenhuma (localhost, domínio atual).
# Padrão se vazio: legalize
VITE_DEFAULT_TENANT=

# ===== Somente modo sem backend (V1) =====
# WhatsApp de atendimento (somente dígitos, com DDI+DDD). Padrão: 5584999999999 (provisório).
# Com backend, o WhatsApp vem da configuração da imobiliária no painel.
VITE_WHATSAPP_NUMBER=

# ===== Analytics de terceiros (opcionais) =====
# Os eventos já passam por src/lib/analytics.ts (dataLayer); com backend também
# são gravados no banco para o painel da imobiliária.
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=

# ===== Servidor (NÃO usar no frontend; etapas futuras) =====
# SUPABASE_SERVICE_ROLE_KEY=   → só em Vercel Functions / Supabase Edge Functions
# SUPABASE_DB_URL=             → migrations via Supabase CLI
