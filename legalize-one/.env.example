# ------------------------------------------------------------------
# Legalize One — variáveis de ambiente
# Todas são OPCIONAIS nesta fase: sem elas o app usa os valores padrão
# e o mock data. Prefixo VITE_ = exposto no bundle do navegador
# (nunca coloque segredos de servidor aqui).
# Na Vercel: Project Settings → Environment Variables.
# ------------------------------------------------------------------

# WhatsApp de atendimento (somente dígitos, com DDI+DDD).
# Padrão se vazio: 5584999999999 (número provisório).
VITE_WHATSAPP_NUMBER=

# Supabase — ainda NÃO utilizado (Sprint futura).
# Quando VITE_SUPABASE_URL estiver definido, lib/images.ts passa a montar
# URLs do Supabase Storage para as fotos dos imóveis.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Bucket público das fotos. Padrão se vazio: imoveis
VITE_SUPABASE_STORAGE_BUCKET=

# Analytics — ainda NÃO instalados; os eventos já passam por lib/analytics.ts.
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=
